# Шаблон .env для VPS. Скопируй в .env на сервере и подставь секреты с текущей машины/VPS.
# Не коммитить .env.

PORT=5001
NODE_ENV=production

# Только PostgreSQL. SQLite не используем.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/messenger_db?schema=public"

# Тот же JWT_SECRET, что уже на проде — иначе все сессии слетят
JWT_SECRET=

FRONTEND_URL=https://potokmessenger.ru
CORS_ORIGINS=https://potokmessenger.ru,https://www.potokmessenger.ru,https://localhost,http://localhost,capacitor://localhost

UNISENDER_API_KEY=
UNISENDER_FROM_EMAIL=
UNISENDER_FROM_NAME=Potok
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=potokmessenger
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://storage.yandexcloud.net/potokmessenger

# Firebase Admin: файл рядом с сервером или JSON в FIREBASE_SERVICE_ACCOUNT_JSON
GOOGLE_APPLICATION_CREDENTIALS=./potok-messenger-firebase-adminsdk.json

RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=
