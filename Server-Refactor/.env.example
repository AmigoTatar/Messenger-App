PORT=5001
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/messenger_db?schema=public"
JWT_SECRET="change_me"

FRONTEND_URL=https://potokmessenger.ru
CORS_ORIGINS=https://potokmessenger.ru,https://www.potokmessenger.ru,http://localhost:5173,https://localhost

UNISENDER_API_KEY=
UNISENDER_FROM_EMAIL=
UNISENDER_FROM_NAME=Potok
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

ADMIN_USER_IDS=
REPORT_EMAIL=

# Канал-инструкция: id из таблицы Channel. Пусто — автоподписка выключена.
WELCOME_CHANNEL_ID=

# ИИ выключен. Не ставить Ollama на этот VPS. Сервис — отдельно, см. potok-ai-bot.
AI_ENABLED=false
# AI_ASSISTANT_ENABLED=false
# AI_USER_ID=
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_SERVICE_TOKEN=

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=potokmessenger
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://storage.yandexcloud.net/potokmessenger

GOOGLE_APPLICATION_CREDENTIALS=./potok-messenger-firebase-adminsdk.json

RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=
